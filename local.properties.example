# Copy this file to local.properties and fill in your values.
# NEVER commit local.properties — it contains your API key and SDK path.

sdk.dir=/Users/apple/.ollie-toolchain/sdk

# YouTube Data API v3 key. Get one in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3")
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY
